{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ATORI",
  "version": "0.2.0",
  "identifier": "app.atori.player",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1430 --host 127.0.0.1 --strictPort",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ATORI アトリ",
        "width": 1400,
        "height": 880,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#0B0B12",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Fleurdelyx/atori/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVENERDN0YxOTg4QTMzRkEKUldUNk00cVk4Y2ROWGR3TjBxZHc1S043ZXhnRFFlckovWE9md0t0b1p0YU5LdkhqR0JzYU9xV1IK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
