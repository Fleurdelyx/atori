    "@tauri-apps/plugin-updater": "^2.11.0",
    "dexie": "^4.0.0",
    "gsap": "^3.13.0",
    "lucide-react": "^0.544.0",
    "motion": "^12.0.0",
    "music-metadata": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
